@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model IEnumerable<EventRegistrationSystem.Models.Registration>

@{
    ViewData["Title"] = "My Registrations";
}

<h1>My Registrations</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        You have not registered for any events yet.
    </div>

    <a asp-controller="Event"
       asp-action="Index"
       class="btn btn-primary">
        Browse Events
    </a>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped table-hover">

            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Venue</th>
                    <th>Registered</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var registration in Model)
                {
                    <tr>

                        <td>
                            <strong>
                                @registration.Event.Title
                            </strong>
                        </td>

                        <td>
                            @registration.Event.EventDate
                                .ToString("dd MMM yyyy")
                        </td>

                        <td>
                            @registration.Event.Venue
                        </td>

                        <td>
                            @registration.RegisteredAt
                                .ToLocalTime()
                                .ToString("dd MMM yyyy HH:mm")
                        </td>

                        <td>

                            @if (registration.Status ==
                                EventRegistrationSystem.Models.RegistrationStatus.Confirmed)
                            {
                                <span class="badge bg-success">
                                    Confirmed
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Cancelled
                                </span>
                            }

                        </td>

                        <td>

                            <a asp-controller="Event"
                               asp-action="Details"
                               asp-route-id="@registration.EventId"
                               class="btn btn-sm btn-outline-primary">
                                View
                            </a>

                            @if (registration.Status ==
                                EventRegistrationSystem.Models.RegistrationStatus.Confirmed)
                            {
                                <form asp-action="Cancel"
                                      method="post"
                                      class="d-inline">

                                    <input type="hidden"
                                           name="id"
                                           value="@registration.Id" />

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Cancel this registration?');">
                                        Cancel
                                    </button>

                                </form>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}
